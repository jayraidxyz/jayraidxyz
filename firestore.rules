rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasParentUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'xFollowed', 'notesRequested', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'xFollowed', 'notesRequested', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.xFollowed is bool
        && data.notesRequested is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPostProgress(data, userId, postSlug) {
      return data.keys().hasAll(['userId', 'slug', 'bookmarked', 'completed', 'lastSection', 'lastSlide', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'slug', 'bookmarked', 'completed', 'lastSection', 'lastSlide', 'note', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && data.slug is string
        && data.slug == postSlug
        && data.slug.size() >= 1
        && data.slug.size() <= 100
        && data.slug.matches('^[a-zA-Z0-9_-]+$')
        && data.bookmarked is bool
        && data.completed is bool
        && data.lastSection is int
        && data.lastSection >= 0
        && data.lastSection <= 50
        && data.lastSlide is int
        && data.lastSlide >= 1
        && data.lastSlide <= 100
        && data.note is string
        && data.note.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'xFollowed', 'notesRequested', 'updatedAt']);

      allow delete: if false;

      match /progress/{postSlug} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(postSlug);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(postSlug)
          && isValidPostProgress(incoming(), userId, postSlug)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasParentUser(userId);

        allow update: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(postSlug)
          && isValidPostProgress(incoming(), userId, postSlug)
          && incoming().userId == existing().userId
          && incoming().slug == existing().slug
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['bookmarked', 'completed', 'lastSection', 'lastSlide', 'note', 'updatedAt'])
          && hasParentUser(userId);

        allow delete: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(postSlug)
          && hasParentUser(userId);
      }
    }
  }
}
